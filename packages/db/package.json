{
  "name": "@mycel/db",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Postgres adapter: Kysely, SQL migrations, Row Level Security (ADR 002)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts"
  },
  "dependencies": {
    "@mycel/core": "*",
    "kysely": "^0.29.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
