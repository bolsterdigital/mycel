{
  "name": "@mycel/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Hono HTTP API and OpenAPI, generated from the core use-case registry",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "default": "./dist/compose.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "worker": "node --env-file-if-exists=../../.env --import tsx src/worker.ts"
  },
  "dependencies": {
    "@mycel/core": "*",
    "@mycel/db": "*",
    "hono": "^4.6.14",
    "@hono/node-server": "^1.13.7",
    "@mycel/mail-tem": "*",
    "zod": "^3.24.1",
    "@mycel/blob": "*",
    "@mycel/media-sharp": "*",
    "@mycel/observability": "*"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "openapi-types": "^12.1.3"
  }
}
