# Caddy in front of Mycel with on-demand TLS (ADR 014 rule 3). A certificate is issued the first
# time a hostname is requested, and only when the application says the hostname may have one:
# `GET /internal/hostnames/allowed?domain=<host>` answers 200 for the platform origin, a platform
# hostname and a verified custom hostname, 404 for anything else (docs/reference/hostnames.md).
#
# `web` and `api` are the service names of the compose stack (TODO #18); adjust to your network.
# The private hosting runbook documents the production values; this file is the shape.

{
	# Let's Encrypt account; the ACME endpoint of your choice.
	email ops@example.org

	on_demand_tls {
		# Caddy asks before it issues. `interval`/`burst` rate-limit how often it asks, so a
		# scan of random hostnames cannot turn into a flood of certificate requests.
		ask http://web:3000/internal/hostnames/allowed
		interval 2m
		burst 5
	}
}

# Every hostname: tenant sites on their platform or custom hostnames, and the platform origin
# (admin at /admin). The application resolves the tenant from the Host header; Caddy only has to
# pass it on and say which scheme and client address it saw (MYCEL_TRUST_PROXY=1 makes the web
# container read these headers: docker/entrypoint.sh).
https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	# The web app handles every path, including /healthz. /internal/* is for Caddy and the
	# orchestrator only: never route it from the outside.
	@internal path /internal/*
	respond @internal 404

	reverse_proxy web:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		# X-Forwarded-For is set by Caddy itself (the client address, then its own).
	}
}

# The HTTP API on its own hostname with an ordinary (not on-demand) certificate.
api.example.org {
	reverse_proxy api:3000
}
