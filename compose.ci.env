# Interpolation values for the CI compose proof (compose.ci.yml). Placeholders only, each one
# allowed exactly in .gitleaks.toml; nothing here is valid anywhere else.
MYCEL_IMAGE=mycel:ci
PG_SUPERUSER_PASSWORD=pg_superuser_ci
MYCEL_DB_PASSWORD=mycel_owner_ci
MYCEL_APP_PASSWORD=mycel_app_ci
MYCEL_AUTH_PASSWORD=mycel_auth_ci
SIGNING_SECRET=ci-only-signing-secret
AUDIT_HASH_KEY=ci-only-audit-hash-key
CONNECTION_CREDENTIAL_KEY=1010101010101010101010101010101010101010101010101010101010101010
PUBLIC_BASE_URL=https://admin.example.test
PLATFORM_DOMAIN=example.test
API_HOST=api.example.test
SECURITY_CONTACT=mailto:security@example.test
ACME_EMAIL=ops@example.test
MAIL_FROM=CI <noreply@example.test>
MAILER=tem
TEM_SECRET_KEY=x
TEM_PROJECT_ID=x
BLOB_STORE=s3
BLOB_S3_ENDPOINT=http://s3:9000
BLOB_S3_BUCKET=mycel-ci
BLOB_S3_ACCESS_KEY_ID=mycel
BLOB_S3_SECRET_ACCESS_KEY=mycel-s3-ci
BLOB_S3_FORCE_PATH_STYLE=1
# Backups (compose.yml services backup and restore; the restore drill, compose.drill.yml).
MYCEL_BACKUP_PASSWORD=mycel_backup_ci
RESTIC_REPOSITORY=/restic
RESTIC_PASSWORD=restic_ci
BACKUP_CHECK_WEEKDAY=always
