# Copy to .env (gitignored). Values below match compose.dev.yml and are for local development only.
# Every key the code reads is here, set or commented out; secrets are change-me placeholders.
# packages/api/src/env-example.test.ts keeps it that way.

# production refuses development shortcuts (console mailer, fs blob store, path-form sites).
# NODE_ENV=development

# Host port for the compose.dev.yml Postgres (default 5432). Change it when 5432 is taken, and
# use the same port in the two URLs below.
# MYCEL_PG_PORT=5435

# Operator role: owns the schema, runs migrations and the seed, drains the outbox (via the
# mycel_worker role). Fronts never use it for tenant data.
DATABASE_URL=postgres://mycel:mycel@localhost:5432/mycel
# Application role: subject to Row Level Security (ADR 002). Migrate sets its password.
APP_DATABASE_URL=postgres://mycel_app:change-me-app@localhost:5432/mycel
MYCEL_APP_PASSWORD=change-me-app
# Authentication login (mycel_authenticator): it can only enter the mycel_auth role, which reads
# operators, memberships and API keys before a tenant is known (migration 0007). Migrate sets
# its password from MYCEL_AUTH_PASSWORD.
AUTH_DATABASE_URL=postgres://mycel_authenticator:change-me-auth@localhost:5432/mycel
MYCEL_AUTH_PASSWORD=change-me-auth

# HMAC key for form timing tokens, confirmation links and IP hashes (min. 16 characters).
SIGNING_SECRET=dev-only-signing-secret-change-me
# HMAC key of the audit log's input hash (min. 16 characters; docs/reference/audit.md). Required
# in production; unset elsewhere means a fixed development key.
AUDIT_HASH_KEY=dev-only-audit-hash-key-change-me
# Platform origin of the web app: the admin and the OIDC redirect live here, and site URLs take
# their scheme and port from it (ADR 014).
PUBLIC_BASE_URL=http://localhost:5173
# Every tenant gets the hostname <slug>.<PLATFORM_DOMAIN> at creation (ADR 014 rule 2). Browsers
# resolve *.localhost to loopback, so http://probe.localhost:5173/signup works without a hosts
# entry. Production: a real domain (mycel.site-style), never localhost or an IP.
PLATFORM_DOMAIN=localhost
# Hosts that serve the development path form /<tenant>/... when no hostname matches. Default
# outside production: localhost,127.0.0.1. Production: unset (the path form does not exist there).
# DEV_HOSTS=localhost,127.0.0.1
# hostnames: absolute site URLs (confirmation links) use the tenant's primary hostname; path: the
# path form on PUBLIC_BASE_URL. Default: path in development, hostnames in production.
# SITE_URL_MODE=path
# 1 when a reverse proxy (Caddy) fronts the web app: the container then reads host, protocol and
# client address from the x-forwarded-* headers. Required in production; keep 0 without a proxy.
# MYCEL_TRUST_PROXY=0
# Platform API (/platform/*, docs/reference/platform-api.md): the bearer token the hoster's portal
# uses to create tenants and set their entitlements and status. Unset: the routes do not exist and
# a self-hoster uses the `mycel` CLI. At least 32 characters; needs nothing but AUTH_DATABASE_URL
# (the routes enter the mycel_platform role from that login, never the schema owner).
# PLATFORM_API_TOKEN=
# Where the "Runs on Mycel" footer credit links (ADR 015 rule 5).
# PLATFORM_CREDIT_URL=https://mycel.dev

# Mail: console prints to stdout (development); tem sends through Scaleway TEM.
MAIL_FROM="Probe <noreply@example.org>"
MAILER=console
# Console mailer only: also write each message as JSON to this directory (dev and test; the
# e2e gate sets it itself). Refused in production.
# MAIL_SPOOL_DIR=.scratch/mail
# TEM_SECRET_KEY=
# TEM_PROJECT_ID=
# TEM_REGION=fr-par
# Minutes after an attempt before the provider's listing is trusted to show it; a message it
# does not list by then counts as not sent (docs/reference/mail.md). An assumption, not measured.
# MAIL_RECONCILE_LAG_MINUTES=15

# Assistance is disabled until a provider is configured and each tenant opts in.
ASSIST_PROVIDER=none
# ASSIST_PROVIDER_LABEL=Mistral AI (Paris)
# ASSIST_BASE_URL=https://api.example.org/v1
# ASSIST_API_KEY=change-me
# ASSIST_TEXT_MODEL=replace-me
# ASSIST_VISION_MODEL=replace-me
ASSIST_TIMEOUT_MS=30000
ASSIST_RETENTION_DAYS=30

# The API key the MCP server acts with. `npm run db:seed` stores its hash as key "seed" of tenant
# probe (content and form reads, supporter reads, content writes, media), so it also works as
# `Authorization: Bearer <key>` on the HTTP API. Make further keys in the admin at /admin/probe.
MYCEL_API_KEY=dev-api-key-change-me
# The API process also drains the outbox and runs jobs unless this is off (then run the worker).
# MYCEL_WORKER=off

# Operator login (OIDC, authorization code + PKCE). Unset: `npm run dev` starts the mock IdP
# (scripts/mock-oidc.mjs) on 127.0.0.1:8799; log in at /admin as admin@probe.test, the admin the
# seed invites. Production needs an https issuer.
# MYCEL_SEED_OPERATOR_EMAIL=admin@probe.test
# OIDC_ISSUER=https://auth.dreamkit.eu
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email

# Media files (TODO #10, docs/reference/media.md). `fs` (default outside production) keeps them in
# BLOB_DIR, relative to the repository root; production requires `s3`, a private S3-compatible
# bucket (Hetzner, Scaleway, MinIO-compatible). The S3 contract suite runs when BLOB_S3_BUCKET is
# set: `docker compose -f compose.dev.yml --profile blob up -d` starts a local one with these values.
# BLOB_STORE=fs
# BLOB_DIR=.scratch/blob
# MYCEL_S3_PORT=9000
# BLOB_S3_ENDPOINT=http://127.0.0.1:9000
# BLOB_S3_REGION=us-east-1
# BLOB_S3_BUCKET=mycel-dev
# BLOB_S3_ACCESS_KEY_ID=mycel
# BLOB_S3_SECRET_ACCESS_KEY=mycel-s3-dev
# BLOB_S3_FORCE_PATH_STYLE=1

# Observability (TODO #17a, docs/reference/observability.md). Every process writes one JSON
# object per line on stdout (the MCP server on stderr), e-mail addresses scrubbed.
# LOG_LEVEL=info
# A Sentry DSN; a self-hosted GlitchTip accepts the same. Empty: errors are log lines only.
# ERROR_REPORTING_DSN=
# ERROR_REPORTING_ENVIRONMENT=development
# Bearer token for the API's /metrics (min. 32 characters). Unset: /metrics is a 404 on the API.
# The worker serves /metrics on its own health port without a token.
# METRICS_TOKEN=
# The worker's /readyz fails when outbox or job lag reaches this many seconds.
# READY_MAX_LAG_SECONDS=900
# Finished jobs older than this many days are deleted daily (open jobs never are).
# JOBS_RETENTION_DAYS=30
# Audit rows older than this many days are deleted daily; the database keeps 30 days regardless.
# AUDIT_RETENTION_DAYS=400

# Production (compose.yml, docs/self-hosting.md). Development does not need these: compose.dev.yml
# and `npm run dev` never read them. On a server, copy this file to .env next to compose.yml and
# set them together with the keys above; compose builds DATABASE_URL, APP_DATABASE_URL and
# AUTH_DATABASE_URL itself from the three passwords, so those URL lines are not used there.
# Passwords go into URLs: use URL-safe values (`openssl rand -hex 32`).
# The image every service runs. Pin a version (ghcr.io/bolsterdigital/mycel:X.Y.Z) in production.
# MYCEL_IMAGE=ghcr.io/bolsterdigital/mycel:latest
# Password of the schema owner `mycel`, a non-superuser role docker/postgres/init-owner.sh creates
# on the first start. Migrate and the worker connect with it.
# MYCEL_DB_PASSWORD=change-me-owner
# Password of the Postgres image's superuser; nothing uses it after the first start.
# PG_SUPERUSER_PASSWORD=change-me-superuser
# Caddy (docker/caddy/Caddyfile): the ACME account e-mail for certificate notices, and the
# hostname of the HTTP API (an ordinary certificate; sites and the admin get theirs on demand).
# ACME_EMAIL=ops@example.org
# API_HOST=api.example.org
# Backups (docker/backup, docs/self-hosting.md § Backups and § Restore). Password of
# `mycel_backup`, the login with BYPASSRLS that docker/postgres/init-backup-role.sh creates on the
# first start; the backup service dumps the database with it. It reads everything and writes only
# which erasure registrations a snapshot holds (erasure_backups, 0021).
# MYCEL_BACKUP_PASSWORD=change-me-backup
# Where restic keeps the snapshots: any restic repository (sftp:user@host:/path, s3:https://...,
# rest:https://..., or a path inside the container). Its password encrypts every snapshot: keep a
# copy outside the server, without it no backup can be read.
# RESTIC_REPOSITORY=sftp:backup@backup.example.org:/mycel
# RESTIC_PASSWORD=change-me-restic
# restic's own credentials for an s3: repository; not the media bucket's BLOB_S3_* keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Snapshots kept per day, week and month; with these defaults the oldest is six months old.
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# BACKUP_KEEP_MONTHLY=6
# ISO weekday (1 Monday ... 7 Sunday) of the weekly `restic check` that reads back 5% of the data;
# `always` checks on every run.
# BACKUP_CHECK_WEEKDAY=7
# Longest a run may take, in seconds, before it fails without writing a snapshot: half of the
# 24 hours a deleted media file stays in storage (MEDIA_PURGE_DELAY_MS), so every file the dump
# needs is still there when it is copied.
# BACKUP_MAX_SECONDS=43200
# Snapshots of the erasure register (`backup erasures`, every 15 minutes) kept: the last ones and
# one per day. The register only grows, so the newest holds everything; the rest is margin.
# ERASURES_KEEP_LAST=48
# ERASURES_KEEP_DAILY=14
